<mxfile host="app.diagrams.net">
  <diagram name="Scenario" id="9dTOoEfDVixHkQZZPwUO">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1490" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v-1" value="Agentic SDLC scenario: a login page from one user story" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1c2230;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="v-2" value="Six agents build it test first: Bob writes the tests before Charlie, Frank, and David write any code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5b6474;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1000" height="24" as="geometry"/></mxCell>
        <mxCell id="v-3" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;• A to F are the agents. Each one is a long-running Claude CLI session that starts in agents/&amp;lt;name&amp;gt;/ and loads its CLAUDE.md.&lt;br&gt;• Arrows are messages through the Redis broker, numbered in order. The monitor page shows every one.&lt;br&gt;• The color of a file shows which agent writes it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#ffffff;strokeColor=#aab2bf;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="190" y="150" width="600" height="112" as="geometry"/></mxCell>
        <mxCell id="v-4" value="Human&lt;br&gt;(product owner)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1c2230;strokeWidth=2;fontColor=#1c2230;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="295" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="v-5" value='&lt;b&gt;&lt;font color="#8a3fb8"&gt;A · Alice&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Requirements analyst&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;writes the specification&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3e9f9;strokeColor=#8a3fb8;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="290" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="v-6" value='&lt;b&gt;&lt;font color="#2c64d6"&gt;B · Bob&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Test engineer&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;writes the tests first (TDD)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8effc;strokeColor=#2c64d6;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="v-7" value='&lt;b&gt;&lt;font color="#b0700c"&gt;C · Charlie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Database developer&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;builds the database&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fbf1e1;strokeColor=#b0700c;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="v-8" value='&lt;b&gt;&lt;font color="#c2413b"&gt;F · Frank&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Back-end developer&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;builds the login API and lockout&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fbe9e8;strokeColor=#c2413b;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="v-9" value='&lt;b&gt;&lt;font color="#0f8a8a"&gt;D · David&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Front-end developer&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;builds the login page&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1f4f4;strokeColor=#0f8a8a;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="v-10" value='&lt;b&gt;&lt;font color="#2d8a57"&gt;E · Erin&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Technical writer&lt;br&gt;&lt;font style="font-size:11px" color="#5b6474"&gt;writes the docs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e5f4ec;strokeColor=#2d8a57;strokeWidth=2;fontColor=#1c2230;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="1240" y="290" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="e-11" value="1  story ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-4" target="v-5"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-12" value="2  spec ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-5" target="v-6"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-6" target="v-7"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="335"/><mxPoint x="840" y="205"/></Array></mxGeometry></mxCell>
        <mxCell id="e-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-6" target="v-9"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="335"/><mxPoint x="840" y="465"/></Array></mxGeometry></mxCell>
        <mxCell id="e-15" value="3  tests ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-6" target="v-8"><mxGeometry x="-0.25" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-7" target="v-10"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="205"/><mxPoint x="1120" y="335"/></Array></mxGeometry></mxCell>
        <mxCell id="e-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-9" target="v-10"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="465"/><mxPoint x="1120" y="335"/></Array></mxGeometry></mxCell>
        <mxCell id="e-18" value="4  part done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-8" target="v-10"><mxGeometry x="0.25" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-19" value="5  docs done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1c2230;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#1c2230;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-10" target="v-4"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="120"/><mxPoint x="70" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="e-20" value="interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5b6474;endArrow=block;endFill=1;fontSize=11;fontColor=#5b6474;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-7" target="v-8"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e-21" value="interfaces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#5b6474;endArrow=block;endFill=1;fontSize=11;fontColor=#5b6474;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v-8" target="v-9"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint x="42" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="v-22" value='&lt;b&gt;agents/shared_context/&lt;/b&gt;  &lt;font color="#5b6474"&gt;read by every agent&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f8fa;strokeColor=#aab2bf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="640" height="300" as="geometry"/></mxCell>
        <mxCell id="v-23" value='&lt;b&gt;user-story-login.md&lt;/b&gt;&lt;br&gt;the user story&lt;br&gt;&lt;font style="font-size:11px" color="#1c2230"&gt;by the human&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#eef0f3;strokeColor=#1c2230;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=14;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="v-24" value='&lt;b&gt;requirements-login.md&lt;/b&gt;&lt;br&gt;the specification&lt;br&gt;&lt;font style="font-size:11px" color="#8a3fb8"&gt;by Alice&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f3e9f9;strokeColor=#8a3fb8;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=14;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="265" y="610" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="v-25" value='&lt;b&gt;test-contract.md&lt;/b&gt;&lt;br&gt;interfaces the tests expect&lt;br&gt;&lt;font style="font-size:11px" color="#2c64d6"&gt;by Bob&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e8effc;strokeColor=#2c64d6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=14;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="v-26" value='&lt;b&gt;team.md&lt;/b&gt;&lt;br&gt;team, workflow, message rules&lt;br&gt;&lt;font style="font-size:11px" color="#1c2230"&gt;by the human&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#eef0f3;strokeColor=#1c2230;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=14;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="v-27" value='&lt;b&gt;scenario.drawio&lt;/b&gt;&lt;br&gt;this diagram&lt;br&gt;&lt;font style="font-size:11px" color="#1c2230"&gt;by the human&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#eef0f3;strokeColor=#1c2230;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=14;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="265" y="700" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="v-28" value="Every agent gets team.md in its context, next to its own CLAUDE.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5b6474;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="v-29" value='&lt;b&gt;target_app/&lt;/b&gt;  &lt;font color="#5b6474"&gt;the product, including its docs&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f8fa;strokeColor=#aab2bf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="730" height="300" as="geometry"/></mxCell>
        <mxCell id="v-30" value='&lt;b&gt;tests/&lt;/b&gt;&lt;br&gt;unit, integration, and e2e tests&lt;br&gt;&lt;font style="font-size:11px" color="#2c64d6"&gt;by Bob&lt;/font&gt;' style="shape=folder;tabWidth=44;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#e8effc;strokeColor=#2c64d6;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="738" y="612" width="130" height="110" as="geometry"/></mxCell>
        <mxCell id="v-31" value='&lt;b&gt;database/&lt;/b&gt;&lt;br&gt;SQLite schema and data access&lt;br&gt;&lt;font style="font-size:11px" color="#b0700c"&gt;by Charlie&lt;/font&gt;' style="shape=folder;tabWidth=44;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#fbf1e1;strokeColor=#b0700c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="880" y="612" width="130" height="110" as="geometry"/></mxCell>
        <mxCell id="v-32" value='&lt;b&gt;backend/&lt;/b&gt;&lt;br&gt;FastAPI app, login API, lockout&lt;br&gt;&lt;font style="font-size:11px" color="#c2413b"&gt;by Frank&lt;/font&gt;' style="shape=folder;tabWidth=44;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#fbe9e8;strokeColor=#c2413b;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="1022" y="612" width="130" height="110" as="geometry"/></mxCell>
        <mxCell id="v-33" value='&lt;b&gt;frontend/&lt;/b&gt;&lt;br&gt;the login page&lt;br&gt;&lt;font style="font-size:11px" color="#0f8a8a"&gt;by David&lt;/font&gt;' style="shape=folder;tabWidth=44;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#e1f4f4;strokeColor=#0f8a8a;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="1164" y="612" width="130" height="110" as="geometry"/></mxCell>
        <mxCell id="v-34" value='&lt;b&gt;docs/&lt;/b&gt;&lt;br&gt;user and developer guides, plus README.md&lt;br&gt;&lt;font style="font-size:11px" color="#2d8a57"&gt;by Erin&lt;/font&gt;' style="shape=folder;tabWidth=44;tabHeight=12;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#e5f4ec;strokeColor=#2d8a57;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="1306" y="612" width="130" height="110" as="geometry"/></mxCell>
        <mxCell id="v-35" value="Each folder belongs to one agent. The others read it, and ask its owner when it needs a change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5b6474;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="738" y="740" width="690" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Architecture" id="agentic-sdlc-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v-1" value="Agentic SDLC architecture: processes and messages" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1c2230;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="v-2" value="Everything runs on one machine. The agents use the Claude CLI with your Claude login, so there is no API key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5b6474;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="24" as="geometry"/></mxCell>
        <mxCell id="v-3" value="Human" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#1c2230;strokeWidth=2;fontColor=#1c2230;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="v-4" value="&lt;b&gt;Monitor page&lt;/b&gt; (browser)&lt;br&gt;Start and Reset buttons&lt;br&gt;agents panel and messages panel&lt;br&gt;message box for the human" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#5b6474;strokeWidth=1.5;fontColor=#1c2230;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="v-5" value="&lt;b&gt;Web server&lt;/b&gt;&lt;br&gt;server/main.py (FastAPI)&lt;br&gt;/api/agents, /api/start, /api/reset&lt;br&gt;/api/messages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#5b6474;strokeWidth=1.5;fontColor=#1c2230;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="v-6" value="&lt;b&gt;Broker&lt;/b&gt;&lt;br&gt;Redis in Docker (broker/compose.yaml)&lt;br&gt;stream &lt;i&gt;sdlc:messages&lt;/i&gt;&lt;br&gt;one consumer group per agent" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#fbe9e8;strokeColor=#c2413b;strokeWidth=2;fontColor=#1c2230;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="v-7" value="&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;agents/run_agents.py&lt;br&gt;keeps the six sessions alive&lt;br&gt;delivers each message as a new turn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#5b6474;strokeWidth=1.5;fontColor=#1c2230;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="v-8" value='&lt;b&gt;Claude CLI sessions&lt;/b&gt;  &lt;font color="#5b6474"&gt;claude -p, one per agent, started in agents/&amp;lt;name&amp;gt;/&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f8fa;strokeColor=#aab2bf;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontColor=#1c2230;" vertex="1" parent="1"><mxGeometry x="880" y="340" width="600" height="320" as="geometry"/></mxCell>
        <mxCell id="v-9" value="&lt;b&gt;team MCP server&lt;/b&gt; (agents/team_mcp.py) in every session: the &lt;b&gt;send_message&lt;/b&gt; tool" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fbe9e8;strokeColor=#c2413b;strokeWidth=1.5;fontColor=#1c2230;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="386" width="560" height="40" as="geometry"/></mxCell>
